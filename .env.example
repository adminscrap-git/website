# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL — used for metadata and the track/cancel link in WhatsApp.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Business contact. The admin panel overrides these from the settings table;
# these are the build-time fallbacks used in metadata and the footer.
NEXT_PUBLIC_WHATSAPP=919515321371
NEXT_PUBLIC_PHONE=+91 95153 21371
NEXT_PUBLIC_EMAIL=hello@scrapsquad.example
NEXT_PUBLIC_CITY=Hyderabad
