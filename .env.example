# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL — used for metadata and the track/cancel link in WhatsApp.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Business contact. The admin panel overrides these from the settings table;
# these are the build-time fallbacks used in metadata and the footer.
NEXT_PUBLIC_WHATSAPP=919515321371
NEXT_PUBLIC_PHONE=+91 95153 21371
NEXT_PUBLIC_EMAIL=hello@scrapsquad.example
NEXT_PUBLIC_CITY=Hyderabad

# ── Google Maps ────────────────────────────────────────────────────
# Browser key: address autocomplete and the admin service-area map.
# MUST be restricted to your domains in Google Cloud Console — it ships
# to every visitor. See docs/SETUP-INTEGRATIONS.md section 1e.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Optional. A second, IP-unrestricted key for server-side geocoding, so the
# browser key never pays for server lookups. Falls back to the one above.
GOOGLE_MAPS_SERVER_KEY=

# ── WhatsApp (Meta Cloud API) ──────────────────────────────────────
# Leave blank and every message queues in the admin outbox for one-tap
# manual sending. Fill them in and the same messages send themselves.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Must match the language your templates were approved under ("en" vs
# "en_US" are different templates to Meta).
WHATSAPP_TEMPLATE_LANG=en
# You invent this one; paste the same string into Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=
# Meta app secret. Without it, delivery receipts are rejected unverified.
WHATSAPP_APP_SECRET=

# Any long random string. Guards /api/notifications/flush, which Vercel
# Cron calls every 5 minutes to retry queued messages.
CRON_SECRET=
